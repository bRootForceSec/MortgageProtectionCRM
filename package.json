{
  "name": "mortgage-protection-crm",
  "version": "0.2.0",
  "description": "Local-first calling CRM for an independent life insurance agent",
  "scripts": {
    "dev": "concurrently -n api,web \"tsx watch src/server/main.ts\" \"vite\"",
    "build": "tsc -p tsconfig.server.json && tsc -p tsconfig.desktop.json && node scripts/copy-assets.mjs && vite build && node scripts/build-info.mjs",
    "start": "node dist/server/main.js",
    "cli": "node dist/server/cli.js",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.desktop.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "desktop": "npm run build && electron .",
    "dist": "npm run build && electron-builder --publish never"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bRootForceSec/mortgageprotectioncrm.git"
  },
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/bRootForceSec/mortgageprotectioncrm/issues"
  },
  "homepage": "https://github.com/bRootForceSec/mortgageprotectioncrm#readme",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@fastify/static": "^10.1.6",
    "better-sqlite3": "^13.0.3",
    "csv-parse": "^7.0.3",
    "electron-updater": "^6.8.9",
    "exceljs": "^4.4.0",
    "fastify": "^5.12.7",
    "js-yaml": "^5.5.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "qrcode": "^1.5.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "main": "dist/desktop/main.js",
  "productName": "Mortgage Protection CRM",
  "build": {
    "appId": "com.brootforcesec.mortgagecrm",
    "productName": "Mortgage Protection CRM",
    "artifactName": "Mortgage-Protection-CRM-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "dist/**/*",
      "assets/**/*",
      "package.json",
      "!dist/**/*.map"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "npmRebuild": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "shortcutName": "Mortgage Protection CRM"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "category": "public.app-category.business"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "category": "Office"
    },
    "publish": {
      "provider": "github",
      "owner": "bRootForceSec",
      "repo": "MortgageProtectionCRM",
      "releaseType": "release"
    }
  }
}
