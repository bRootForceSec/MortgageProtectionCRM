{
  "manifest_version": 2,
  "name": "Mortgage Protection CRM: Unitrust appointments",
  "version": "1.2.0",
  "description": "Reads appointment colors off your Unitrust calendar and sends them to the CRM on this computer.",
  "browser_specific_settings": { "gecko": { "id": "unitrust-appointments@mpcrm.local", "strict_min_version": "115.0" } },
  "permissions": ["storage", "http://127.0.0.1/*", "http://localhost/*"],
  "background": { "scripts": ["background.js"] },
  "content_scripts": [
    {
      "matches": ["https://myunitrust.com/*", "https://*.myunitrust.com/*"],
      "js": ["calendar.js", "content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "options_ui": { "page": "options.html", "open_in_tab": false },
  "browser_action": { "default_title": "CRM: Unitrust appointments" }
}
