# Every environment variable the app reads. All are optional.
# Linux service: put the ones you need in ~/.config/mpcrm/env (mode 600) and run
#   systemctl --user restart mpcrm
# Desktop app or npm start: set them in the environment before starting. Nothing loads this file.

# --- Settings you might change ---
# Where the database and files live. Default: ~/.local/share/mpcrm on Linux, "Mortgage CRM" in your home folder on Windows and Mac.
# MPCRM_DATA_DIR=
# Local port. The app only listens on 127.0.0.1.
# MPCRM_PORT=5170
# Where backups go. Default: <data dir>/backups. An external drive is better.
# MPCRM_BACKUP_DIR=
# How many backups to keep. At least 1; a value that isn't a whole number means 30.
# MPCRM_BACKUP_KEEP=30
# An age public key (https://github.com/FiloSottile/age). Backups are then encrypted with it.
# MPCRM_BACKUP_AGE_RECIPIENT=

# --- Set by the Linux install and updater; you normally leave these alone ---
# The install folder (the installer uses ~/.local/share/mpcrm-app). When set, the app knows it runs as the Linux service and can update itself.
# MPCRM_APP_DIR=
# Branch the Linux updater follows.
# MPCRM_UPDATE_BRANCH=main
# The systemd unit the updater restarts.
# MPCRM_SERVICE=mpcrm.service
# How long the updater waits for a new version to answer before rolling back, in ms.
# MPCRM_HEALTH_TIMEOUT_MS=60000
# The build command the updater runs (tests replace it with a fast fake).
# MPCRM_UPDATE_BUILD_CMD=
# The commit recorded in the build (set by the updater).
# MPCRM_COMMIT=

# --- Tests only ---
# Points the desktop updater at a local folder of release files instead of GitHub.
# MPCRM_UPDATE_FEED=
